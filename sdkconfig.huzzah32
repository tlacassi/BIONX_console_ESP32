# Adafruit HUZZAH32 Feather classic ESP32; proposed pinout, rewire explicitly.
CONFIG_IDF_TARGET="esp32"
CONFIG_BIONX_BOARD_HUZZAH32=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG is not set
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_BIONX_LCD_RST=27
CONFIG_BIONX_LCD_CS=14
CONFIG_BIONX_LCD_DC=32
CONFIG_BIONX_LCD_MOSI=18
CONFIG_BIONX_LCD_SCLK=5
CONFIG_BIONX_MCP_MISO=19
CONFIG_BIONX_MCP_CS=33
CONFIG_BIONX_MCP_INT=34
