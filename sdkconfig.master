# Neutral master only. Battery discovery queries at boot; external wake.
CONFIG_BIONX_CAN_MASTER=y
# CONFIG_BIONX_CAN_OBSERVE is not set
# CONFIG_BIONX_DASHBOARD_DEMO is not set
# CONFIG_BIONX_USB_TEST_ONLY is not set
# CONFIG_BIONX_MCP_HARDWARE_VERIFIED is not set
CONFIG_BIONX_MCP_OSC_MHZ=0
CONFIG_BIONX_LCD_MIRROR_Y=y
# CONFIG_BIONX_ACTIVE is not set
# C3 USB workaround only. Feather overrides these console selections.
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# CONFIG_ESP_CONSOLE_SECONDARY_NONE is not set
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_FREERTOS_HZ=1000
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_DEF_REFR_PERIOD=50
CONFIG_LV_MEM_SIZE_KILOBYTES=32
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
