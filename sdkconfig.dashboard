# Separate build profile for the attached GC9A01, with no vehicle drivers.
CONFIG_BIONX_DASHBOARD_DEMO=y
# Correct the vertical reflection observed on the attached module.
CONFIG_BIONX_LCD_MIRROR_Y=y
# CONFIG_BIONX_USB_TEST_ONLY is not set
# CONFIG_BIONX_ACTIVE is not set
# Work around the local SDK USB-only startup fault. GPIO21 is console TX.
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# CONFIG_ESP_CONSOLE_SECONDARY_NONE is not set
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_DEF_REFR_PERIOD=33
CONFIG_LV_MEM_SIZE_KILOBYTES=48
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_48=y
# CONFIG_LV_USE_LOG is not set
