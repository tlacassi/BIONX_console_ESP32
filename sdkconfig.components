CONFIG_IDF_TARGET="esp32"
CONFIG_BIONX_COMPONENT_TEST=y
CONFIG_BIONX_TEST_BUTTON_GPIO=22
CONFIG_BIONX_MCP_OSC_MHZ=8
# User reports all modules powered at 3.3V, crystal 8MHz. Passive test only.
CONFIG_BIONX_MCP_HARDWARE_VERIFIED=y
CONFIG_FREERTOS_HZ=1000

CONFIG_BIONX_TEST_MCP=y
CONFIG_BIONX_LCD_CLOCK_MHZ=20
CONFIG_BIONX_MCP_SPI_CLOCK_MHZ=2
CONFIG_BIONX_MCP_USE_INT=y
